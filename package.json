export const TAB_COLORS = [
  '#e74c3c','#e91e8c','#9b59b6','#3498db','#27ae60',
  '#f39c12','#e67e22','#16a085','#2ecc71','#95a5a6','#c0392b'
];

const mk = (text) => ({ id: 'c_' + Math.random().toString(36).substr(2,6), text, done: false });
const ms = (text, date, urgente=false) => ({ id: 's_' + Math.random().toString(36).substr(2,6), text, date, urgente });
const mc = (name, role, color) => {
  const initials = name.split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase();
  return { id: 'ct_' + Math.random().toString(36).substr(2,6), initials, name, role, color };
};

